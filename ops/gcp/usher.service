# System unit on the usher-prod VM (docs/DEPLOY.md step 6): the host's usher.service
# without the dev workspace. A system unit, not a user one: OS Login users get
# neither linger nor a user bus, so `systemctl --user` cannot run there.
# Installed by `vm-setup.sh service` into /etc/systemd/system/; the checkout
# path is the owner's OS Login home. After `up -d`, usher-heal.sh recreates
# once any service that is not healthy within 3 minutes (a preemption can
# leave `api` without its network, docs/DEPLOY.md §2); its `-` keeps the unit
# up whatever it finds.
[Unit]
Description=usher production on Google Cloud (docs/DEPLOY.md): db, redis, grafana, evcrawl scheduler, events api, cloudflared tunnel; no dev workspace
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/olavostauros_gmail_com/usher
ExecStart=/usr/bin/docker compose up -d db redis grafana evcrawl api cloudflared
ExecStartPost=-/bin/bash /home/olavostauros_gmail_com/usher/ops/gcp/usher-heal.sh
TimeoutStartSec=420
ExecStop=/usr/bin/docker compose stop cloudflared api evcrawl grafana redis db

[Install]
WantedBy=multi-user.target
