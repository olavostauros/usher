[Unit]
Description=usher (evcrawl) workspace: db, redis, dev, grafana (production runs on the VM, ops/gcp/usher.service)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Work/usher
ExecStart=/usr/bin/docker compose up -d db redis dev grafana
ExecStop=/usr/bin/docker compose stop grafana dev redis db

[Install]
WantedBy=default.target
