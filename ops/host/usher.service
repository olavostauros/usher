[Unit]
Description=usher (evcrawl) team workspace: db, redis, dev
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Work/usher
ExecStart=/usr/bin/docker compose up -d db redis dev
ExecStop=/usr/bin/docker compose stop dev redis db

[Install]
WantedBy=default.target
