[Unit]
Description=usher (evcrawl) stack: db, redis, nominatim, dev workspace, evcrawl scheduler
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Work/usher
ExecStart=/usr/bin/docker compose up -d db redis nominatim dev evcrawl
ExecStop=/usr/bin/docker compose stop evcrawl dev nominatim redis db

[Install]
WantedBy=default.target
