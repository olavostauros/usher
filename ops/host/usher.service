[Unit]
Description=usher (evcrawl) stack: db, redis, nominatim, dev workspace, grafana, evcrawl scheduler, events api, cloudflared tunnel
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Work/usher
ExecStart=/usr/bin/docker compose up -d db redis nominatim dev grafana evcrawl api cloudflared
ExecStop=/usr/bin/docker compose stop cloudflared api evcrawl grafana dev nominatim redis db

[Install]
WantedBy=default.target
