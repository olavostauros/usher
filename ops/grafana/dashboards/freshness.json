  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scheduler heartbeat age",
      "description": "Seconds since the scheduler's heartbeat job last wrote its row (every minute). Down when older than 5 minutes or when there is no row: the same rule as ops/host/status.py and the spec 3 heartbeat SLA.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select age_seconds from v_scheduler"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "down (no heartbeat)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      }
    },
