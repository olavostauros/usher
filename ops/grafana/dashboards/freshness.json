    {
      "id": 3,
      "type": "stat",
      "title": "Verdicts",
      "description": "Source x city pairs per verdict (the selected sources and cities).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select count(*) filter (where verdict = 'fresh')::int as fresh,\n       count(*) filter (where verdict = 'running')::int as running,\n       count(*) filter (where verdict = 'stale')::int as stale,\n       count(*) filter (where verdict = 'errors')::int as errors,\n       count(*) filter (where verdict = 'never')::int as never\n  from v_source_city_freshness\n where source in (${source:sqlstring}) and coalesce(city, '-') in (${city:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fresh"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stale"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "never"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Freshness grid: city x source",
      "description": "One cell per source x city, coloured by the view's verdict (fresh, running, stale, errors, never). '-' is a whole-source run without a city; an empty cell means that source never crawled that city.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select coalesce(city, '-') as city, source, verdict\n  from v_source_city_freshness\n where source in (${source:sqlstring}) and coalesce(city, '-') in (${city:sqlstring})\n order by 1, 2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "inspect": false,
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "fresh": {
                  "color": "green",
                  "index": 0,
                  "text": "fresh"
                },
                "running": {
                  "color": "blue",
                  "index": 1,
                  "text": "running"
                },
                "stale": {
                  "color": "orange",
                  "index": 2,
                  "text": "stale"
                },
                "errors": {
                  "color": "red",
                  "index": 3,
                  "text": "errors"
                },
                "never": {
                  "color": "purple",
                  "index": 4,
                  "text": "never"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "empty",
                "result": {
                  "color": "transparent",
                  "index": 5,
                  "text": "·"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "city\\source"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "displayName",
                "value": "city \\ source"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "source",
            "rowField": "city",
            "valueField": "verdict",
            "emptyValue": "empty"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Age vs SLA",
      "description": "Age of the last finished crawl as a share of its SLA (100 % = stale). The 40 oldest pairs.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select source || ' · ' || coalesce(city, '-') as pair,\n       age_seconds::float / sla_seconds as age_vs_sla\n  from v_source_city_freshness\n where finished_at is not null and source in (${source:sqlstring}) and coalesce(city, '-') in (${city:sqlstring})\n order by 2 desc\n limit 40"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.5,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Not fresh",
      "description": "Every source x city that is not fresh: errors first, then stale, never, running. error_line is the first line of the last run's error_detail.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select source,\n       coalesce(city, '-') as city,\n       verdict,\n       age_seconds,\n       finished_at,\n       running_since,\n       errors,\n       error_line\n  from v_source_city_freshness\n where verdict <> 'fresh' and source in (${source:sqlstring}) and coalesce(city, '-') in (${city:sqlstring})\n order by case verdict\n            when 'errors' then 0\n            when 'stale' then 1\n            when 'never' then 2\n            else 3\n          end,\n          age_seconds desc nulls last"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fresh": {
                        "color": "green",
                        "index": 0,
                        "text": "fresh"
                      },
                      "running": {
                        "color": "blue",
                        "index": 1,
                        "text": "running"
                      },
                      "stale": {
                        "color": "orange",
                        "index": 2,
                        "text": "stale"
                      },
                      "errors": {
                        "color": "red",
                        "index": 3,
                        "text": "errors"
                      },
                      "never": {
                        "color": "purple",
                        "index": 4,
                        "text": "never"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "color": "transparent",
                        "index": 5,
                        "text": "·"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "displayName",
                "value": "age"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "finished_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running_since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      }
    }
  ]
