      "id": 1,
      "type": "stat",
      "title": "Active in-person events with a located venue",
      "description": "Share of scheduled/updated non-online events whose venue has a location (the spec 3 geocode SLA).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
