            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select coalesce(city, '?') || '/' || coalesce(uf, '?') as city,\n       venues_without_location\n  from v_catalog_by_city\n where venues_without_location > 0\n order by 2 desc\n limit 30"
