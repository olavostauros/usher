    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean run duration",
      "description": "Mean seconds from started_at to finished_at, weighted by runs.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select hour as time, source as metric, sum(mean_seconds * runs) / nullif(sum(runs) filter (where mean_seconds is not null), 0) as value\n  from v_crawl_runs_hourly\n where $__timeFilter(hour) and source in (${source:sqlstring}) and kind in (${kind:sqlstring})\n group by hour, source\n order by 1, 2"
        }
