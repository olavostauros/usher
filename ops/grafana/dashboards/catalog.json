    {
      "id": 1,
      "type": "stat",
      "title": "Catalog",
      "description": "Events with status scheduled or updated; of those, starting within 7 days; flagged dedupe_review; removed_from_source; source listings behind them.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "evcrawl"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "evcrawl"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select sum(events_active) as active,\n       sum(events_upcoming_7d) as upcoming_7d,\n       sum(events_under_review) as under_review,\n       sum(events_removed) as removed,\n       sum(listings) as listings\n  from v_catalog_by_city"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
