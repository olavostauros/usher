# Copy to .env for local runs. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://evcrawl:evcrawl@db:5432/evcrawl
REDIS_URL=redis://redis:6379/0
# Use a real, reachable contact address. The public Nominatim answers 403 to
# any User-Agent that mentions example.org (verified 2026-09-20).
EVCRAWL_CONTACT_EMAIL=contato@example.org
EVCRAWL_USER_AGENT=EventoLivreBot/0.1 (+mailto:contato@example.org)
# The compose `nominatim` service (ops/host/README.md, "Geocoder"). Falling
# back to the public instance is https://nominatim.openstreetmap.org with
# EVCRAWL_GEOCODE_RPS=1.0 (its policy; the geocoder clamps to 1 there anyway).
NOMINATIM_URL=http://nominatim:8080
# Requests per second at the geocoder. Raise only against the self-hosted instance.
EVCRAWL_GEOCODE_RPS=1.0
LOG_LEVEL=INFO

# Host owner only: address the dev container's SSH port is published on.
# Set it to this machine's Tailscale IPv4 (`tailscale ip -4`). Never 0.0.0.0.
DEV_SSH_BIND=127.0.0.1
# Host owner only: hard caps for the dev container (all members share them).
DEV_MEMORY_LIMIT=16g
DEV_CPU_LIMIT=12

# Host owner only: the self-hosted Nominatim (imported once; hours, tens of GB).
# The password is internal to the compose network but must not be the image default.
NOMINATIM_PASSWORD=change-me
NOMINATIM_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
NOMINATIM_THREADS=4
NOMINATIM_SHM_SIZE=1g
NOMINATIM_SHARED_BUFFERS=1GB
NOMINATIM_MAINTENANCE_WORK_MEM=4GB
NOMINATIM_EFFECTIVE_CACHE_SIZE=8GB

# Host owner only: password of the read-only `grafana_ro` database role that the
# Grafana datasource uses (docs/specs/phase-3-monitoring.md). Migration 0005
# sets it when `evcrawl migrate` runs with the variable in its environment;
# unset (scratch databases, CI) the role exists without login.
GRAFANA_DB_PASSWORD=change-me
# Host owner only: password of Grafana's `admin` user (the `grafana` compose
# service, published on DEV_SSH_BIND:3000). Team members browse the dashboards
# as anonymous viewers and never need it; it is for the datasource "Save &
# test" and nothing else. Neither GRAFANA_* variable reaches members' shells.
GRAFANA_ADMIN_PASSWORD=change-me
