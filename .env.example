# Copy to .env for local runs. Never commit a real .env.
# Inside the dev container DATABASE_URL and PG* are preset for the `team` role
# (docker-compose.yml) and win over this line; set it here only to point your
# clone at your <login>_scratch database.
DATABASE_URL=postgresql+psycopg://team:change-me@db:5432/evcrawl
REDIS_URL=redis://redis:6379/0
# Use a real, reachable contact address. The public Nominatim answers 403 to
# any User-Agent that mentions example.org (verified 2026-09-20).
EVCRAWL_CONTACT_EMAIL=contato@example.org
EVCRAWL_USER_AGENT=EventoLivreBot/0.1 (+mailto:contato@example.org)
# The compose `nominatim` service (ops/host/README.md, "Geocoder"). Falling
# back to the public instance is https://nominatim.openstreetmap.org with
# EVCRAWL_GEOCODE_RPS=1.0 (its policy; the geocoder clamps to 1 there anyway).
NOMINATIM_URL=http://nominatim:8080
# Requests per second at the geocoder. Raise only against the self-hosted instance.
EVCRAWL_GEOCODE_RPS=1.0
LOG_LEVEL=INFO

# The events API (`evcrawl api`, docs/specs/phase-4-api.md). It connects as
# `api_ro`, never with DATABASE_URL, and refuses to start without this URL. In
# your clone point it at your <login>_scratch database; on the host the `api`
# compose service builds it from EVCRAWL_API_DB_PASSWORD.
EVCRAWL_API_DATABASE_URL=
# Comma-separated browser origins allowed to call the API (CORS); empty: none.
# The site's origin is the `api` compose service's default; a clone running
# `evcrawl api` for itself can leave it empty.
EVCRAWL_API_CORS_ORIGINS=https://eventolivre.com
# 1 only behind our own proxy: the rate limiter then keys on the last
# X-Forwarded-For address. On the host the API sits behind the Cloudflare
# tunnel, so 1 (the compose default); 0 there would put every public client in
# one bucket. In a clone with no proxy the header is simply never sent.
EVCRAWL_API_TRUST_PROXY=1

# Host owner only: the database passwords (F-014, F-001). POSTGRES_PASSWORD is
# the superuser `evcrawl`: compose gives it to the release container (migrate,
# scheduler) only. TEAM_DB_PASSWORD is the `team` role every member connects
# as; `evcrawl migrate` applies it. Both go into URLs: letters and digits only
# (`openssl rand -hex 24`). POSTGRES_PASSWORD initialises an empty volume only;
# changing it on a live one is ops/host/README.md, "Database roles".
POSTGRES_PASSWORD=change-me
TEAM_DB_PASSWORD=change-me

# Host owner only: address the dev container's SSH port, Grafana and the
# events API are published on. Set it to this machine's Tailscale IPv4
# (`tailscale ip -4`). Never 0.0.0.0.
DEV_SSH_BIND=127.0.0.1
# Host owner only: hard caps for the dev container (all members share them).
DEV_MEMORY_LIMIT=16g
DEV_CPU_LIMIT=12
# Host owner only: memory caps for the other services (F-024). NOMINATIM's must
# stay above its shared_buffers + maintenance_work_mem + shm_size below.
DB_MEMORY_LIMIT=4g
REDIS_MEMORY_LIMIT=512m
NOMINATIM_MEMORY_LIMIT=8g
GRAFANA_MEMORY_LIMIT=1g
EVCRAWL_MEMORY_LIMIT=2g
API_MEMORY_LIMIT=512m
CLOUDFLARED_MEMORY_LIMIT=256m

# Host owner only: the Cloudflare Tunnel that publishes the events API as
# https://api.eventolivre.com (ops/host/README.md "Public exposure"). The id
# is what `cloudflared tunnel create usher-api` printed; its credentials file
# goes to ops/host/cloudflared/credentials.json (gitignored). Unset, the
# `cloudflared` compose service fails to start and nothing is public.
CLOUDFLARE_TUNNEL_ID=
# uid:gid the tunnel runs as: the owner of credentials.json (mode 600).
CLOUDFLARED_USER=1000:1000

# Host owner only: the self-hosted Nominatim (imported once; hours, tens of GB).
# The password is internal to the compose network but must not be the image default.
NOMINATIM_PASSWORD=change-me
NOMINATIM_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
NOMINATIM_THREADS=4
NOMINATIM_SHM_SIZE=1g
NOMINATIM_SHARED_BUFFERS=1GB
NOMINATIM_MAINTENANCE_WORK_MEM=4GB
NOMINATIM_EFFECTIVE_CACHE_SIZE=8GB

# Host owner only: password of the read-only `grafana_ro` database role that the
# Grafana datasource uses (docs/specs/phase-3-monitoring.md). Migration 0005
# sets it when `evcrawl migrate` runs with the variable in its environment;
# unset (scratch databases, CI) the role exists without login.
GRAFANA_DB_PASSWORD=change-me
# Host owner only: password of the read-only `api_ro` database role the events
# API logs in with (docs/specs/phase-4-api.md). Migration 0008 creates the
# role; `evcrawl migrate` applies this when named on its command line
# (ops/host/release.sh); unset (scratch databases, CI) the role has no login.
EVCRAWL_API_DB_PASSWORD=change-me
# Host owner only: password of Grafana's `admin` user (the `grafana` compose
# service, published on DEV_SSH_BIND:3000). Team members browse the dashboards
# as anonymous viewers and never need it; it is for the datasource "Save &
# test" and nothing else. Neither GRAFANA_* variable reaches members' shells.
GRAFANA_ADMIN_PASSWORD=change-me
