{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run evcrawl --help)",
      "Bash(uv run evcrawl version)",
      "Bash(uv run evcrawl crawl:*)",
      "Bash(evcrawl --help)",
      "Bash(evcrawl version)",
      "Bash(evcrawl crawl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(psql:*)",
      "Bash(rg:*)",
      "Bash(curl -sL -A:*)"
    ],
    "deny": [
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(/home/*/.ssh/**)",
      "Read(**/.credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
